{
	email team@kupe.in
	# IP certs: tls-alpn-01 is rejected by Let's Encrypt ("wrong number of identifiers").
	# http-01 on :80 is the only challenge that works for 137.184.140.206.
	cert_issuer acme {
		profile shortlived
		disable_tlsalpn_challenge
	}
	servers {
		protocols h1 h2
	}
}

# Let's Encrypt IP cert (short-lived). Uvicorn stays on :8000.
# Vercel HTTPS UI connects to wss://137.184.140.206/ws
https://{$ASR_HOST:137.184.140.206} {
	reverse_proxy 127.0.0.1:8000
}
